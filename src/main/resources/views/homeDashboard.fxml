<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HomeDashboardController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="welcomeLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #334756;" text="Bonjour, Utilisateur" />
                        <Label fx:id="dateLabel" style="-fx-font-size: 14px; -fx-text-fill: #555;" text="30 Juin 2025" />
                    </children>
                </HBox>
                <!-- Indicateurs Clés -->
                <HBox spacing="20.0">
                    <children>
                        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Chiffre d'Affaires du Jour" />
                                <Label fx:id="dailySalesLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #28a745;" text="0 FCFA" />
                            </children>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Commandes du Jour" />
                                <Label fx:id="dailyOrdersLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #007bff;" text="0" />
                            </children>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);" HBox.hgrow="ALWAYS">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Produit le Plus Vendu" />
                                <Label fx:id="topProductLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #6f42c1;" text="-" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <!-- Section Stock Faible -->
                <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);" VBox.vgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #dc3545;" text="Produits à Surveiller" />
                        <TableView fx:id="lowStockTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colProductName" prefWidth="200.0" text="Produit" />
                                <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock Restant" />
                                <TableColumn fx:id="colCategory" prefWidth="150.0" text="Catégorie" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>