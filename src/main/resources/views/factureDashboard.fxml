<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FactureDashboardController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #334756;" text="Facturation" />
            <HBox spacing="20.0">
               <children>
                  <!-- Formulaire de création -->
                  <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);" HBox.hgrow="NEVER">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Nouvelle Facture" />
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Nom du Client" />
                              <TextField fx:id="clientNameField" prefWidth="300.0" promptText="Entrez le nom du client" />
                           </children>
                        </VBox>
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label text="Table N°" />
                                    <ChoiceBox fx:id="tableChoiceBox" prefWidth="145.0" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label text="Date" />
                                    <DatePicker fx:id="datePicker" prefWidth="145.0" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Ajouter un Article" />
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Produit" />
                              <ChoiceBox fx:id="productChoiceBox" prefWidth="300.0" />
                           </children>
                        </VBox>
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label text="Quantité" />
                                    <TextField fx:id="quantityField" prefWidth="145.0" promptText="Qté" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label text="Prix Unitaire" />
                                    <TextField fx:id="unitPriceField" prefWidth="145.0" promptText="Prix" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <JFXButton onAction="#handleAddItem" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="Ajouter Article" />
                     </children>
                  </VBox>
                  <!-- Détails de la facture -->
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <TableView fx:id="factureItemsTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colDesignation" prefWidth="250.0" text="Désignation" />
                              <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Qté" />
                              <TableColumn fx:id="colUnitPrice" prefWidth="120.0" text="Prix Unitaire" />
                              <TableColumn fx:id="colTotalPrice" prefWidth="120.0" text="Prix Total" />
                              <TableColumn fx:id="colActions" prefWidth="100.0" text="Actions" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Total Général:" />
                              <TextField fx:id="totalGeneralField" alignment="CENTER_RIGHT" editable="false" prefWidth="150.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="0 FCFA" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <JFXButton onAction="#handleSaveFacture" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Enregistrer la Facture" HBox.hgrow="ALWAYS" />
                              <JFXButton onAction="#handlePrintFacture" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;" text="Imprimer" />
                              <JFXButton onAction="#clearAllFields" style="-fx-background-color: #ffc107; -fx-text-fill: white; -fx-font-weight: bold;" text="Nouvelle Facture" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>