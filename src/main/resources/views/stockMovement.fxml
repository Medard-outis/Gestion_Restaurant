<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #f4f7f9;" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StockMovementController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #334756;" text="Mouvements de Stock">
                    <graphic>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Images/icons8-vendre-les-stock-64.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Label>
                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Formulaire de mouvement -->
                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 0);" HBox.hgrow="NEVER">
                            <children>
                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Nouveau Mouvement" />
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Produit" />
                                        <ChoiceBox fx:id="productChoiceBox" prefWidth="300.0" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Type de mouvement" />
                                        <HBox spacing="20.0">
                                            <children>
                                                <RadioButton fx:id="entreeRadio" mnemonicParsing="false" text="Entrée">
                                                    <toggleGroup>
                                                        <ToggleGroup fx:id="movementTypeGroup" />
                                                    </toggleGroup>
                                                </RadioButton>
                                                <RadioButton fx:id="sortieRadio" mnemonicParsing="false" text="Sortie" toggleGroup="$movementTypeGroup" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Quantité" />
                                        <TextField fx:id="quantityField" promptText="Entrez une quantité" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Raison" />
                                        <TextArea fx:id="reasonTextArea" prefHeight="80.0" promptText="La raison de ce mouvement" wrapText="true" />
                                    </children>
                                </VBox>
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Date" />
                                        <DatePicker fx:id="datePicker" prefWidth="300.0" />
                                    </children>
                                </VBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <JFXButton fx:id="processButton" onAction="#handleProcessMovement" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;" text="Enregistrer" />
                                        <JFXButton fx:id="clearButton" onAction="#handleClearFields" style="-fx-background-color: #ffc107; -fx-text-fill: white; -fx-font-weight: bold;" text="Annuler" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <!-- Table des mouvements -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <TextField fx:id="filterField" HBox.hgrow="ALWAYS" promptText="Rechercher par produit, raison..." />
                                        <ChoiceBox fx:id="filterTypeChoiceBox" prefWidth="150.0" />
                                        <JFXButton style="-fx-background-color: #6c757d; -fx-text-fill: white;" text="Imprimer" />
                                    </children>
                                </HBox>
                                <TableView fx:id="movementsTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colProduct" prefWidth="150.0" text="Produit" />
                                        <TableColumn fx:id="colType" prefWidth="75.0" text="Type" />
                                        <TableColumn fx:id="colQuantity" prefWidth="75.0" text="Qté" />
                                        <TableColumn fx:id="colReason" prefWidth="200.0" text="Raison" />
                                        <TableColumn fx:id="colDate" prefWidth="120.0" text="Date" />
                                        <TableColumn fx:id="colUser" prefWidth="120.0" text="Utilisateur" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
