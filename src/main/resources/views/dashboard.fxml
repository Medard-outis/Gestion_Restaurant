<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@../styles/dashboard.css" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashBoardController">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <!-- En-tête -->
            <top>
                <HBox alignment="CENTER_LEFT" styleClass="header">
                    <children>
                        <Label styleClass="header-title" text="Tableau de Bord" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <ImageView fx:id="Reduire" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../Images/icons8-moins-48.png" />
                           </image>
                        </ImageView>
                        <ImageView fx:id="Exit" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../Images/close.png" />
                            </image>
                        </ImageView>
                    </children>
                </HBox>
            </top>
            <!-- Menu latéral -->
            <left>
                <VBox styleClass="sidebar" BorderPane.alignment="CENTER">
                    <children>
                        <JFXButton onAction="#home" styleClass="sidebar-button" text="Accueil" />
                        <JFXButton onAction="#facturations" styleClass="sidebar-button" text="Facturations" />
                        <JFXButton fx:id="gestionButton" onAction="#gestion" styleClass="sidebar-button" text="Gestion Stock" />
                        <JFXButton fx:id="utilisateursButton" onAction="#utilisateurs" styleClass="sidebar-button" text="Utilisateurs" />
                        <JFXButton fx:id="historiquesButton" onAction="#historiques" styleClass="sidebar-button" text="Historiques" />
                        <JFXButton fx:id="mouvementsStockButton" onAction="#mouvementsStock" styleClass="sidebar-button" text="Mouvements" />
                        <VBox VBox.vgrow="ALWAYS" />
                        <JFXButton fx:id="logoutButton" onAction="#handleLogout" styleClass="logout-button" text="Déconnexion" />
                    </children>
                </VBox>
            </left>
            <!-- Contenu principal -->
            <center>
                <StackPane fx:id="contentArea" styleClass="content-area" BorderPane.alignment="CENTER" />
            </center>
        </BorderPane>
    </children>
</AnchorPane>
